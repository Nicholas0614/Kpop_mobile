<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="145dp"
        android:padding="14dp">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbSelectItem"
            android:layout_width="40dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:button="@null"
            android:buttonTint="@null"
            android:gravity="center"
            app:buttonCompat="@drawable/checkbox_selector"
            app:buttonTint="@null"/>

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_toEndOf="@id/cbSelectItem"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/banner1"/>

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:padding="5dp"
            android:src="@drawable/delete_24dp_1f1f1f_fill0_wght400_grad0_opsz24"
            app:tint="#111111"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgProduct"
            android:layout_toStartOf="@id/btnDelete"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Product"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Album"
                android:textColor="#777777"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="RM83.12"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:padding="9dp"
                    android:src="@drawable/ic_minus"
                    app:tint="#111111"/>

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="45dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:padding="9dp"
                    android:src="@drawable/ic_plus"
                    app:tint="#111111"/>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>